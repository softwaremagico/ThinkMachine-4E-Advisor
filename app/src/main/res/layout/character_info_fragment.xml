<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/equipment_frame"
    style="@style/LayoutPadding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical"
    tools:context="com.softwaremagico.tm.advisor.ui.character.info.CharacterInfoFragmentCharacter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:divider="?android:dividerHorizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.softwaremagico.tm.advisor.ui.components.TranslatedEditText
                android:id="@+id/character_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                custom:translation="name" />

            <ImageView
                android:id="@+id/button_random_name"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_weight="0"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ic_dice"
                android:contentDescription="TODO"
                android:gravity="bottom" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.softwaremagico.tm.advisor.ui.components.TranslatedEditText
                android:id="@+id/character_surname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                custom:translation="surname" />

            <ImageView
                android:id="@+id/button_random_surname"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_weight="0"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ic_dice"
                android:gravity="bottom" />

        </LinearLayout>

        <com.softwaremagico.tm.advisor.ui.components.EnumSpinner
            android:id="@+id/character_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="gender" />

        <com.softwaremagico.tm.advisor.ui.components.TranslatedEditText
            android:id="@+id/character_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="age" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.softwaremagico.tm.advisor.ui.components.TranslatedEditText
                android:id="@+id/character_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                custom:translation="level" />

            <ImageView
                android:id="@+id/button_add_level"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_weight="0"
                android:background="@drawable/add"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:gravity="end" />

            <ImageView
                android:id="@+id/button_remove_level"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_weight="0"
                android:background="@drawable/remove"
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:gravity="bottom" />
        </LinearLayout>

        <com.softwaremagico.tm.advisor.ui.components.ElementSpinner
            android:id="@+id/character_specie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="specie" />

        <com.softwaremagico.tm.advisor.ui.components.ElementSpinner
            android:id="@+id/character_upbringing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="upbringing" />

        <com.softwaremagico.tm.advisor.ui.components.ElementSpinner
            android:id="@+id/character_faction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="faction" />

        <com.softwaremagico.tm.advisor.ui.components.ElementSpinner
            android:id="@+id/character_calling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="calling" />

        <com.softwaremagico.tm.advisor.ui.components.ElementSpinner
            android:id="@+id/character_planet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            custom:translation="planet" />

        <View style="@style/Divider.Horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:orientation="vertical"
            android:scrollbars="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_title_module"
                style="@style/SettingsTitle"
                />

            <!-- Official Modules -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_section_official"
                style="@style/SettingsSubtitle"
                />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_player_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_player_guide" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_factions_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_factions_book" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_lost_worlds_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_lost_worlds_book" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_imperial_dossier_brother_battle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_imperial_dossier_brother_battle" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_imperial_dossier_charioteers_guild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_imperial_dossier_charioteers_guild" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_imperial_dossier_house_hawkwood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_imperial_dossier_house_hawkwood" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_imperial_dossier_reeves_guild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_imperial_dossier_reeves_guild" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_vuldrok_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_vuldrok_space" />

            <!-- Custom Modules -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_section_custom"
                style="@style/SettingsSubtitle"
                />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_revised_edition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_revised_edition" />

        </LinearLayout>

        <View style="@style/Divider.Horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                style="@style/SettingsTitle"
                />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/official_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_nonofficial" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/restricted_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_restricted" />

        </LinearLayout>


    </LinearLayout>


</ScrollView>